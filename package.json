    "@nestjs/testing": "11.1.24",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/nest": "22.7.5",
    "@nx/next": "22.7.5",
    "@nx/node": "22.7.5",
    "@nx/web": "22.7.5",
