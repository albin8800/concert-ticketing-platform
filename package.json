{
  "name": "high-concurrency-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "concurrently -n \"GATEWAY,AUTH,BOOKING,WEB\" -c \"cyan,magenta,yellow,emerald\" \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:booking\" \"npm run start:web\"",
    "start:gateway": "npx tsx watch --tsconfig apps/gateway/tsconfig.app.json apps/gateway/src/main.ts",
    "start:auth": "npx tsx watch --tsconfig apps/auth-service/tsconfig.app.json apps/auth-service/src/main.ts",
    "start:booking": "npx tsx watch --tsconfig apps/booking-service/tsconfig.app.json apps/booking-service/src/main.ts",
    "start:web": "nx serve web",
    "build:web": "nx build web",
    "db:migrate": "npx prisma migrate dev --schema=libs/db-schema/prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=libs/db-schema/prisma/schema.prisma",
    "proto:generate": "node scripts/generate-proto.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.0.1",
    "axios": "1.16.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "5.11.0",
    "lucide-react": "^1.17.0",
    "next": "~16.1.6",
    "next-themes": "^0.4.6",
    "passport-jwt": "4.0.1",
    "pg": "8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.6.0",
