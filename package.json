{
  "name": "high-concurrency-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "concurrently -n \"GATEWAY,AUTH,BOOKING\" -c \"cyan,magenta,yellow\" \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:booking\"",
  
     "start:gateway": "npx tsx watch --tsconfig apps/gateway/tsconfig.app.json apps/gateway/src/main.ts",
     "start:auth": "npx tsx watch --tsconfig apps/auth-service/tsconfig.app.json apps/auth-service/src/main.ts",
     "start:booking": "npx tsx watch --tsconfig apps/booking-service/tsconfig.app.json apps/booking-service/src/main.ts",
  
     "db:migrate": "npx prisma migrate dev --schema=libs/db-schema/prisma/schema.prisma",
     "db:generate": "npx prisma generate --schema=libs/db-schema/prisma/schema.prisma",
     "proto:generate": "node scripts/generate-proto.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "latest",
    "@grpc/proto-loader": "latest",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "latest",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "latest",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "amqp-connection-manager": "latest",
    "amqplib": "latest",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "latest",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/nest": "22.7.5",
    "@nx/next": "22.7.5",
    "@nx/node": "22.7.5",
    "@nx/web": "22.7.5",
    "@nx/webpack": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "~30.0.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.5",
    "prettier": "~3.6.2",
    "prisma": "latest",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "ts-proto": "latest",
    "tslib": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.40.0"
  }
}
